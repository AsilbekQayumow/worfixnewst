# ── WORFIX web app (copy to .env.local for local development) ─────────────────
# Without the Firebase values the app runs in LOCAL DEMO MODE (browser-only data, labelled in the UI).

# Firebase web config — the same Firebase project as before (Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Server-only (never prefix with NEXT_PUBLIC_) ───────────────────────────────
# Powers the GPS mission agent (/api/ai/missions) and the photo check (/api/ai/verify).
GEMINI_API_KEY=
# Optional: force a model. By default the newest available Flash models are listed from the API.
# GEMINI_MODEL=gemini-flash-latest
# Walking routes and place search (openrouteservice.org → Dev Dashboard → token). Without it the app
# uses the public OSRM and Photon services.
ORS_API_KEY=
