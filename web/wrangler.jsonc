{
  // WORFIX on Cloudflare Workers. Build and deploy: scripts/deploy-cloudflare.sh (see DEPLOY.md).
  // Secrets (set once: npx wrangler secret put <NAME>): GEMINI_API_KEY, ORS_API_KEY, FIREBASE_SERVICE_ACCOUNT.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worfix",
  "main": "worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Next route-group chunks ("(public)", "(auth)") are requested as %28…%29; the asset server
  // redirects that to the literal form and browsers loop. worker.ts serves them instead.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none", "run_worker_first": ["/_next/static/chunks/app/*"] },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "worfix" }],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "worfix.site", "custom_domain": true },
    { "pattern": "www.worfix.site", "custom_domain": true }
  ],
  // v3.2: the daily territory decay, 00:15 UTC; v5: the streak reminder push, 13:00 UTC (18:00 Tashkent);
  // v6: mission reminders every 30 minutes
  "triggers": { "crons": ["15 0 * * *", "0 13 * * *", "*/30 * * * *"] },
  "vars": {
    "CONTEXT": "production",
    "NEXT_PUBLIC_FIREBASE_PROJECT_ID": "worfix3",
    "SITE_URL": "https://worfix.site"
  },
  "observability": { "enabled": true }
}
