<?xml version="1.0" encoding="utf-8"?>
<!-- The walk, collapsed: two numbers on WORFIX green -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:background="@drawable/walk_panel_bg" android:paddingStart="14dp" android:paddingEnd="14dp"
    android:paddingTop="10dp" android:paddingBottom="10dp">
    <ImageView android:id="@+id/walk_dot" android:layout_width="26dp" android:layout_height="26dp"
        android:src="@drawable/ic_walk_footprints" android:contentDescription="@null" />
    <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:orientation="vertical" android:layout_marginStart="12dp">
        <TextView android:id="@+id/walk_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#D9FFFFFF" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/walk_distance" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/walk_distance_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=" · "
                android:textColor="#B3FFFFFF" android:textSize="18sp" />
            <TextView android:id="@+id/walk_area" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/walk_area_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
        </LinearLayout>
        <TextView android:id="@+id/walk_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
