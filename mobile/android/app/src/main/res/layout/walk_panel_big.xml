<?xml version="1.0" encoding="utf-8"?>
<!-- The walk, expanded (and on the lock screen): distance, area, how far the start is -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="@drawable/walk_panel_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/walk_dot" android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/ic_walk_footprints" android:contentDescription="@null" />
        <TextView android:id="@+id/walk_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/walk_stat_bg" android:padding="10dp" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/walk_distance_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/walk_distance" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/walk_stat_bg" android:padding="10dp" android:layout_marginStart="6dp">
            <TextView android:id="@+id/walk_area_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#CCFFFFFF" android:textSize="11sp" android:textStyle="bold" />
            <TextView android:id="@+id/walk_area" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/walk_hint" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:textColor="#F2FFFFFF" android:textSize="13sp" android:maxLines="2" />
</LinearLayout>
