<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/w_card" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_w_map_color" android:contentDescription="@null" />
        <TextView android:id="@+id/a_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="@string/widget_area" android:textColor="@color/w_muted" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/a_rank" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/w_chip_sky"
            android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:text="#3" android:textColor="@color/w_ink" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/a_body" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <ImageView android:id="@+id/a_map" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp"
            android:background="@drawable/w_tile" android:scaleType="fitCenter" android:contentDescription="@null" />
        <TextView android:id="@+id/a_area" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="12 400 m²" android:textColor="@color/w_ink" android:textSize="18sp" android:textStyle="bold" android:maxLines="1" />
    </LinearLayout>
    <LinearLayout android:id="@+id/a_empty_box" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center" android:visibility="gone">
        <TextView android:id="@+id/a_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
            android:text="" android:textColor="@color/w_muted" android:textSize="12sp" android:maxLines="3" />
        <LinearLayout android:id="@+id/a_walk_btn" android:layout_width="wrap_content" android:layout_height="36dp" android:layout_marginTop="10dp" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/w_button_flame" android:paddingStart="12dp" android:paddingEnd="14dp">
            <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_w_footprints_white" android:contentDescription="@null" />
            <TextView android:id="@+id/a_walk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
                android:text="" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
