<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/w_card" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/tree_label" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="@string/widget_tree" android:textColor="@color/w_muted" android:textSize="12sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical"
            android:background="@drawable/w_chip" android:paddingStart="7dp" android:paddingEnd="8dp" android:paddingTop="2dp" android:paddingBottom="2dp">
            <ImageView android:layout_width="12dp" android:layout_height="12dp" android:src="@drawable/ic_w_check" android:contentDescription="@null" />
            <TextView android:id="@+id/tree_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="3dp"
                android:text="12" android:textColor="@color/w_ink" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <ImageView android:id="@+id/tree_img" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:layout_marginTop="4dp" android:src="@drawable/tree_s3_t0" android:scaleType="fitCenter" android:contentDescription="@null" />
    <TextView android:id="@+id/tree_stage" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:text="@string/widget_tree" android:textColor="@color/w_ink" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/tree_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:layout_marginTop="2dp" android:text="@string/widget_tree_desc" android:textColor="@color/w_muted" android:textSize="11sp" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
