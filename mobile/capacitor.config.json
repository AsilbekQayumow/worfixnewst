{
  "appId": "site.worfix.app",
  "appName": "WORFIX",
  "webDir": "www",
  "appendUserAgent": "WorfixApp/1.0",
  "backgroundColor": "#f4f8f1",
  "server": {
    "url": "https://worfix.site/app",
    "errorPath": "offline.html",
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 900,
      "launchAutoHide": true,
      "backgroundColor": "#1fa84a",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    },
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DEFAULT"
    }
  }
}
